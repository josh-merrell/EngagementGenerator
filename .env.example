# Copy this file to .env for local development. Never commit .env.

# OpenAI
OPENAI_API_KEY=sk-...

# Google Imagen — set one of these depending on your chosen endpoint:
GOOGLE_API_KEY=...                         # Gemini API endpoint
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json  # Vertex AI endpoint

# Facebook
FACEBOOK_PAGE_ACCESS_TOKEN=...
FACEBOOK_PAGE_ID=...

# S3 — Lambda reads config from here, then discovers project files via the prefix in config.yaml
S3_BUCKET=my-engagementbot-bucket
S3_CONFIG_KEY=config.yaml

# Optional: set to "true" to generate content but skip posting (dry-run mode)
DRY_RUN=false
